{
  // Configuración para desplegar en Cloudflare Workers (con archivos estáticos)
  "name": "huffmanificador",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Las rutas /api/* las atiende primero el Worker; lo demás son archivos estáticos
    "run_worker_first": ["/api/*"]
  }
}
